# Copy to .env for local development. Never commit .env.
# These are local-only values; staging/production secrets live in AWS.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://shop:shop_local_only@localhost:5433/shop
REDIS_URL=redis://localhost:6379
POSTGRES_USER=shop
POSTGRES_PASSWORD=shop_local_only
POSTGRES_DB=shop
POSTGRES_PORT=5433
