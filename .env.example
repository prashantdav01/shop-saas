# Copy to .env for local development. Never commit .env.
# These are local-only values; staging/production secrets live in AWS.
NODE_ENV=development
PORT=3000
# API connects as a restricted role (row-level security applies to it).
DATABASE_URL=postgres://shop_app:shop_app_local_only@localhost:5433/shop
# Migrations run as the owner role (not a superuser), created by pnpm db:bootstrap.
MIGRATION_DATABASE_URL=postgres://shop_owner:shop_owner_local_only@localhost:5433/shop
# The container superuser; used only by pnpm db:bootstrap.
BOOTSTRAP_DATABASE_URL=postgres://shop:shop_local_only@localhost:5433/shop
REDIS_URL=redis://localhost:6379
POSTGRES_USER=shop
POSTGRES_PASSWORD=shop_local_only
POSTGRES_DB=shop
POSTGRES_PORT=5433
