{
  "name": "shop-saas",
  "private": true,
  "packageManager": "pnpm@10.6.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "docker compose up -d && pnpm -r --parallel --filter ./apps/* dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "db:migrate": "pnpm --filter api db:migrate",
    "rules:sync": "node sync-rules.mjs"
  },
  "devDependencies": {
    "eslint": "^10.14.0",
    "prettier": "^3.10.1",
    "typescript": "~5.9",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@parcel/watcher",
      "lmdb",
      "msgpackr-extract"
    ]
  }
}
